{
  "name": "meeting-note-taker",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.1.1",
  "type": "module",
  "main": "src/electron/main.js",
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  },
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "test:main": "node --test src/electron/*.test.js scripts/*.test.mjs",
    "test:ui": "vitest run",
    "setup:backend": "node scripts/setup-backend.mjs",
    "lock:python": "node scripts/lock-python.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "fetch:llama": "node scripts/fetch-llama.mjs",
    "fetch:speaker-model": "node scripts/fetch-speaker-model.mjs",
    "fetch:vendor": "npm run fetch:ffmpeg && npm run fetch:llama && npm run fetch:speaker-model",
    "build:backend": "node scripts/build-backend.mjs",
    "dist": "npm run fetch:vendor && npm run build && npm run build:backend && electron-builder --publish never",
    "release": "node scripts/release.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "build": {
    "appId": "com.meetingnotetaker.app",
    "productName": "DeskRecap",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-react/**/*",
      "!dist-react/wrangler.json",
      "!dist-react/.assetsignore",
      "src/electron/**/*",
      "!src/electron/**/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/app-backend",
        "to": "backend"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/llama",
        "to": "llama"
      },
      {
        "from": "vendor/speaker",
        "to": "speaker"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DeskRecap needs microphone access to record your voice during meetings."
      }
    },
    "beforePack": "scripts/check-extra-resources.mjs",
    "afterSign": "scripts/notarize.mjs",
    "publish": {
      "provider": "s3",
      "bucket": "meeting-note-taker-updates",
      "region": "auto",
      "endpoint": "https://cf527edf58223c391e60611f545f5f0c.r2.cloudflarestorage.com",
      "acl": null
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.0",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.36.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "aws4": "^1.13.2",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "png2icons": "^2.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
