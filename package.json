{
  "name": "meeting-note-taker",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:main": "node --test src/electron/*.test.js",
    "test:ui": "vitest run",
    "setup:backend": "node scripts/setup-backend.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "dist": "npm run build && npm run build:backend && npm run fetch:ffmpeg && electron-builder"
  },
  "build": {
    "appId": "com.meetingnotetaker.app",
    "productName": "DeskRecap",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-react/**/*",
      "src/electron/**/*",
      "!src/electron/**/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/app-backend",
        "to": "backend"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "s3",
      "bucket": "meeting-note-taker-updates",
      "region": "auto",
      "endpoint": "https://cf527edf58223c391e60611f545f5f0c.r2.cloudflarestorage.com",
      "acl": null
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "electron-updater": "^6.8.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "electron": "^39.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
