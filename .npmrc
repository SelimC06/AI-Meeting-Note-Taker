# Makes the "engines" field in package.json a hard requirement rather than a warning.
#
# Without this, an old npm that happens to come first on PATH will install this
# project anyway and rewrite package-lock.json into its own older lockfileVersion.
# That is not hypothetical: an npm 6 / Node 12 install at /usr/local/bin silently
# downgraded the lockfile from v3 to v1, which dropped every peer dependency npm 6
# does not auto-install (@testing-library/dom among them) and broke the whole
# `npm run test:ui` suite with a "Cannot find package" error that pointed nowhere
# near the real cause. Failing loudly at install time is much cheaper to diagnose.
engine-strict=true
