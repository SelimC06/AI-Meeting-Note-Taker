# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-react
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend runtime data
backend/app/uploads/
backend/app/settings.json
backend/.pytest_cache/

# Python bytecode
__pycache__/
*.pyc

# Backend virtualenv (produced by npm run setup:backend)
.venv/

# Vendored build tools (fetched, not checked in)
vendor/

# PyInstaller build output (produced by npm run build:backend)
backend-dist
build/pyinstaller
backend/app-backend.spec

# electron-builder output (produced by npm run dist)
release

# Downloaded/generated benchmark inputs (LibriSpeech corpus, derived audio
# clips and transcripts) - large and reproducible via the benchmarks/*.py
# scripts; only the scripts and results/ summaries are checked in.
benchmarks/data/

# Secrets: R2/AWS release keys, App Store / other private keys, local env
# files (see README "Publishing a release" -- load keys from one of these,
# never type them inline). !.env.example keeps a template committable.
.env*
!.env.example
.dev.vars
*.p8

# Wrangler (Cloudflare) local state
.wrangler/
